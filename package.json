{
  "name": "beyondplay-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Build a BeyondPlay mini-game with your own agent: the skill, the starter game, the validator and the checks, and the path to the creator MCP.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "new-game": "node scripts/new-game.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node tools/beyondplay-check/bin/beyondplay-check.mjs",
    "check-build": "node scripts/check-build.mjs",
    "smoke:render": "node scripts/smoke-render.mjs",
    "smoke:seed": "node scripts/smoke-seed.mjs",
    "smoke:idle": "node scripts/smoke-idle.mjs",
    "conformance": "node scripts/conformance.mjs",
    "ladder": "node scripts/ladder.mjs",
    "render-icon": "node scripts/render-icon.mjs",
    "render-banner": "node scripts/render-banner.mjs",
    "pack": "node scripts/pack.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run --root tools/beyondplay-check",
    "browser": "playwright install chromium",
    "agent": "node scripts/agent.mjs",
    "mcp": "node scripts/mcp-client.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.27.0",
    "matter-js": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.166.1",
    "zzfx": "^1.3.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/howler": "^2.2.13",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.166.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.45.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^3.2.0"
  }
